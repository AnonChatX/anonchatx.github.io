---
const target = "https://anonomi.org/";
const delaySeconds = 5;
const delayMs = delaySeconds * 1000;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Anonomi has moved</title>

    <!-- Fallback if JS is disabled -->
    <meta http-equiv="refresh" content={`${delaySeconds}; url=${target}`} />

    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />

    <style>
      body {
        background: #0a0a0a;
        color: #e5e7eb;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        display: flex;
        min-height: 100vh;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 2rem;
      }
      a { color: #6d4aff; }
      .box { max-width: 520px; }
      .hint { margin-top: 1rem; font-size: 0.875rem; color: #9ca3af; }
    </style>

    <script is:inline>
      {`setTimeout(() => {
        const target = ${JSON.stringify(target)};
        location.replace(target + location.search + location.hash);
      }, ${delayMs});`}
    </script>
  </head>

  <body>
    <div class="box">
      <h1>AnonChatX is now Anonomi</h1>

      <p>
        This website is now available at:<br />
        <strong><a href="https://anonomi.org/">https://anonomi.org</a></strong>
      </p>

      <p class="hint">
        You will be redirected automatically in {delaySeconds} seconds.
        If not, click the link above.
      </p>
    </div>
  </body>
</html>